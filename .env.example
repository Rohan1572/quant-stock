# API server configuration. Copy to `.env` at the repo root and fill in real values.
# The api-server `start` script loads this file automatically via --env-file-if-exists.
# NOTE: `.env` is gitignored — never commit real credentials.

# Required: port the Express API listens on (src/index.ts throws if missing)
PORT=5000

# Required: Postgres connection string (lib/db/src/index.ts throws if missing)
DATABASE_URL=postgresql://postgres:<your-password>@localhost:5432/quantstock

# Optional
# BASE_PATH=/
# LOG_LEVEL=info
# NODE_ENV=development

# Optional: extra origins allowed to read /api responses (comma-separated).
# localhost:3000/:3001 are always allowed; an unlisted origin gets no CORS
# headers and the browser blocks the read.
# CORS_ORIGINS=https://app.example.com

# Optional: extra Host header values the Vite dev/preview server accepts.
# Needed to reach it by a name other than localhost.
# VITE_ALLOWED_HOSTS=my-machine.local

# Optional: port the frontend proxies /api to. Default matches the API's.
# API_PORT=5000