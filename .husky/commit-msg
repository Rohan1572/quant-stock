message=$(sed -n '1p' "$1")

case "$message" in
  "Merge "*|"Revert \""*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([[:alnum:]][[:alnum:]./_-]*\))?(!)?: .{1,72}$'

if ! printf '%s\n' "$message" | grep -Eq "$pattern"; then
  printf '%s\n' \
    "Invalid commit message: $message" \
    "Use: type(scope)!: subject (subject max 72 characters)" \
    "Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  exit 1
fi
