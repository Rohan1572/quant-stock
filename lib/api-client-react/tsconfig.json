{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    // orval's generated fetch helper iterates `Headers`, which needs dom.iterable.
    "lib": ["dom", "dom.iterable", "es2022"]
  },
  "include": ["src"]
}
