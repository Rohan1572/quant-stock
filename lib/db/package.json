{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "migrate": "node-pg-migrate -j ts up",
    "migrate:down": "node-pg-migrate -j ts down",
    "migrate:create": "node-pg-migrate -j ts create"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "pg": "8.22.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "@types/pg": "8.20.0",
    "node-pg-migrate": "9.0.0"
  }
}
