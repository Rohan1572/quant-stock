{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "npm run --workspace=@workspace/quantstock dev",
    "dev:api": "npm run --workspace=@workspace/api-server dev",
    "dev:mockup": "npm run --workspace=@workspace/mockup-sandbox dev",
    "build": "npm run typecheck && npm run build:apps",
    "build:apps": "npm run --workspaces --if-present build",
    "codegen": "npm run --workspace=@workspace/api-spec codegen",
    "reinstall": "node -e \"const fs=require('fs');for(const p of ['node_modules','package-lock.json','.package-lock.json'])fs.rmSync(p,{recursive:true,force:true});\" && npm cache clean --force && npm i",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm run typecheck:apps",
    "typecheck:apps": "npm run --workspaces --if-present typecheck"
  },
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "private": true,
  "dependencies": {
    "@floating-ui/react-dom": "2.1.9",
    "@replit/connectors-sdk": "0.4.1",
    "regexparam": "3.0.0"
  },
  "devDependencies": {
    "lightningcss": "1.33.0",
    "prettier": "3.9.5",
    "tapable": "2.3.3",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "@hookform/resolvers@3.10.0": true,
    "esbuild": true,
    "react-hook-form@7.85.0": true,
    "recharts@3.10.1": true,
    "tailwindcss-animate@1.0.7": true
  }
}
