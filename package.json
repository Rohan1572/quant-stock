{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "npm run --workspace=@workspace/quantstock dev",
    "dev:api": "npm run --workspace=@workspace/api-server dev",
    "dev:mockup": "npm run --workspace=@workspace/mockup-sandbox dev",
    "build": "npm run typecheck && npm run build:apps",
    "build:apps": "npm run --workspaces --if-present build",
    "verify": "npm run audit:deps && npm run audit:vulns && npm run typecheck && npm run test && npm run lint && npm run format:check && npm run build:apps",
    "typecheck": "npm run typecheck:libs && npm run typecheck:apps",
    "typecheck:libs": "tsc --build",
    "typecheck:apps": "npm run --workspaces --if-present typecheck",
    "test": "npm run --workspaces --if-present test",
    "lint": "eslint --max-warnings 0 -c eslint.sonar.config.mjs artifacts/api-server/src artifacts/quantstock/src lib/db/src lib/api-client-react/src lib/api-spec/orval.config.ts",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:deps": "node ./scripts/audit-dependencies.mjs",
    "audit:vulns": "node ./scripts/audit-vulnerabilities.mjs",
    "codegen": "npm run --workspace=@workspace/api-spec codegen",
    "db:migrate": "npm run --workspace=@workspace/db migrate",
    "db:migrate:down": "npm run --workspace=@workspace/db migrate:down",
    "clean": "node ./scripts/clean-build.mjs",
    "reinstall": "node ./scripts/reset-install.mjs && npm install"
  },
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "private": true,
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "lightningcss": "1.33.0",
    "prettier": "3.9.5",
    "tapable": "2.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "allowScripts": {
    "@hookform/resolvers@3.10.0": true,
    "esbuild": true,
    "react-hook-form@7.81.0": true,
    "recharts@3.10.1": true,
    "tailwindcss-animate@1.0.7": true
  }
}
